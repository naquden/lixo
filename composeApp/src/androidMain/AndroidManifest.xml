<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Microphone permission for real-time AI reading assistant (requested during tutorial via parent) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Optional network access for delta content sync & friend avatar gallery -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Package visibility for Android 11+ (API 30+) SpeechRecognizer and TextToSpeech services -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:label="Lixo"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!-- Launcher activity lives in androidApp (se.lixo.app.MainActivity). Declaring one here
             merged a second, non-existent se.lixo.shared.MainActivity launcher into the app. -->
    </application>

</manifest>
